# ============================================================================
# X Obunachi Multi-Userbot Tizimi — Muhit o'zgaruvchilari (.env.example)
# Nusxalab .env nomli fayl yarating va qiymatlarni to'ldiring.
# Vercel va GitHub Actions Secrets bo'limiga ham aynan shu kalitlarni kiriting.
# ============================================================================

# --- Telegram Admin Bot (@BotFather) ---
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Vergul bilan ajratilgan admin Telegram ID'lari (masalan: 123456789,987654321)
ADMIN_IDS=123456789

# --- Telegram Userbot API (https://my.telegram.org) ---
DEFAULT_API_ID=12345678
DEFAULT_API_HASH=0123456789abcdef0123456789abcdef

# --- Supabase (https://supabase.com -> Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Vercel Webhook Sozlamalari ---
# Vercel loyiha manzili (oxirida "/" belgisisiz), masalan: https://my-userbot.vercel.app
WEBHOOK_BASE_URL=https://your-vercel-app.vercel.app
# Webhook himoya kaliti (ixtiyoriy uzun tasodifiy matn)
WEBHOOK_SECRET=super_secret_webhook_token_2026

# --- Xavfsizlik: StringSession shifrlash (Tavsiya etiladi!) ---
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bo'sh qoldirilsa, sessiyalar shifrlanmasdan saqlanadi.
SESSION_ENCRYPTION_KEY=

# --- Ixtiyoriy: Admin Botdan GitHub Actions Worker'ni qo'lda ishga tushirish ---
# GitHub Personal Access Token (workflow ruxsati bilan)
GITHUB_TOKEN=
# Format: username/repo-name
GITHUB_REPO=
GITHUB_WORKER_WORKFLOW=worker.yml

# --- Maqsadli bot va standart qiymatlar ---
DEFAULT_TARGET_BOT=XObunachiBot
LOG_LEVEL=INFO
